{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: device (Release)",
      "type": "shell",
      "command": "./build.sh device Release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build: device (Debug)",
      "type": "shell",
      "command": "./build.sh device Debug",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build: simulator (Debug)",
      "type": "shell",
      "command": "./build.sh sim Debug",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Install on device (USB)",
      "type": "shell",
      "dependsOn": "Build: device (Release)",
      "command": "./scripts/install-device.sh",
      "problemMatcher": []
    }
  ]
}